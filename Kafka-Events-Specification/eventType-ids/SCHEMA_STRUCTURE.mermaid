graph TB
    MAIN["<b>SAFIDSEventType</b><br/><i>Main IDS Event Type</i>"]
    
    MAIN --> CE["<b>CloudEvents Standard</b><br/>(required)"]
    MAIN --> SAF["<b>SAF Domain</b><br/>(required)"]
    MAIN --> IDS["<b>IDS Processing Metadata</b><br/>(optional extensions)"]
    MAIN --> PROC["<b>Process Tracking</b><br/>(required)"]
    
    CE --> CE1["✓ id<br/>✓ source<br/>✓ specversion<br/>✓ type: ch.ecohub.saf.ids<br/>datacontenttype<br/>dataschema<br/>subject<br/>time"]
    
    SAF --> SAF1["✓ licenceKey<br/>✓ userAgent<br/>✓ eventReceiver<br/>✓ eventSender<br/><b>data</b><br/>(IDSEventDataType)"]
    
    SAF1 --> DATA["<b>Data Envelope</b><br/>(5 properties)"]
    DATA --> DATA1["• payload (AES-256)<br/>• payloadSignature (ECDSA)<br/>• encryptionKey (RSA)<br/>• publicKeyVersion<br/>• signatureKeyVersion"]
    
    IDS --> IDS_SCALAR["<b>Scalar Metrics</b><br/>(7 properties)"]
    IDS --> IDS_QUALITY["<b>Quality Scores</b><br/>(4 properties)"]
    IDS --> IDS_COMPLEX["<b>Complex Objects</b><br/>(7 properties)"]
    
    IDS_SCALAR --> IDS_S1["• idsprocessingModel<br/>• idsmodelVersion<br/>• idsconfidenceScore<br/>• idsprocessingTimeMs<br/>• idsdocumentType<br/>• idssourceFormat<br/>• idspageCount"]
    
    IDS_QUALITY --> IDS_Q1["• idsocrQuality<br/>• idsdocumentQuality<br/>• idscompletenessScore<br/>• idssourceDocumentHash"]
    
    IDS_COMPLEX --> IDS_C1["• idspreprocessingPipeline<br/>• idspreprocessingImpactAnalysis<br/>• idsfieldExtractionDetails<br/>• idsfieldTransformationRecord<br/>• idsdocumentQualityAssessment<br/>• idsreceiverRecommendations ⭐<br/>• idsvalidationResults"]
    
    PROC --> PROC1["✓ processId<br/>✓ processName<br/>✓ processVersion<br/>✓ subProcessName<br/>✓ processStatus<br/>✓ subProcessStatus<br/>processGroupId"]
    
    style MAIN fill:#4A90E2,stroke:#2E5C8A,color:#fff,font-size:16px
    style CE fill:#50C878,stroke:#2E7D4E,color:#fff,font-weight:bold
    style SAF fill:#FF6B6B,stroke:#8B3E3E,color:#fff,font-weight:bold
    style IDS fill:#FFB84D,stroke:#8B6914,color:#000,font-weight:bold
    style PROC fill:#9B59B6,stroke:#5A3370,color:#fff,font-weight:bold
    style DATA fill:#FF6B6B,stroke:#8B3E3E,color:#fff
    style IDS_SCALAR fill:#FFD700,stroke:#8B7500,color:#000
    style IDS_QUALITY fill:#FFD700,stroke:#8B7500,color:#000
    style IDS_COMPLEX fill:#FFD700,stroke:#8B7500,color:#000
    style CE1 fill:#E8F5E9,stroke:#2E7D4E,color:#000
    style SAF1 fill:#FFEBEE,stroke:#8B3E3E,color:#000
    style DATA1 fill:#FFEBEE,stroke:#8B3E3E,color:#000
    style IDS_S1 fill:#FFFACD,stroke:#8B7500,color:#000
    style IDS_Q1 fill:#FFFACD,stroke:#8B7500,color:#000
