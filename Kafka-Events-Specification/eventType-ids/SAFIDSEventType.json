{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "SAF Intelligent Data Structuring event. The root contains CloudEvents attributes and scalar SAF/IDS extension attributes for filtering, routing, and search. Complex processing metadata is carried under data.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../CloudEventsType.json#/definitions/iddef"
    },
    "source": {
      "$ref": "../CloudEventsType.json#/definitions/sourcedef"
    },
    "specversion": {
      "$ref": "../CloudEventsType.json#/definitions/specversiondef"
    },
    "type": {
      "allOf": [
        {
          "$ref": "../event-generic/EventType.json"
        },
        {
          "const": "ch.ecohub.saf.ids"
        }
      ]
    },
    "datacontenttype": {
      "$ref": "../CloudEventsType.json#/definitions/datacontenttypedef"
    },
    "dataschema": {
      "$ref": "../CloudEventsType.json#/definitions/dataschemadef"
    },
    "subject": {
      "$ref": "../CloudEventsType.json#/definitions/subjectdef"
    },
    "time": {
      "$ref": "../CloudEventsType.json#/definitions/timedef"
    },
    "licenceKey": {
      "$ref": "../event-generic/LicenceKeyType.json"
    },
    "userAgentName": {
      "description": "Name of the client application that produced or requested the event. Full userAgent object is available under data.userAgent.",
      "type": "string",
      "minLength": 1
    },
    "userAgentVersion": {
      "description": "Version of the client application that produced or requested the event. Full userAgent object is available under data.userAgent.",
      "type": "string",
      "minLength": 1
    },
    "eventReceiverCategory": {
      "description": "Receiver organisation category used for filtering and routing. Full eventReceiver object is available under data.eventReceiver.",
      "type": "string",
      "enum": ["broker", "insurer", "serviceprovider"]
    },
    "eventReceiverId": {
      "description": "Receiver IDP identifier used for filtering and routing. Full eventReceiver object is available under data.eventReceiver.",
      "type": "string",
      "minLength": 3
    },
    "eventReceiverOnBehalfBy": {
      "description": "Optional IDP number of the software provider's techUser if the event is received on behalf.",
      "type": "string",
      "pattern": "^IDP(\\d{7})$"
    },
    "eventSenderCategory": {
      "description": "Sender organisation category used for filtering and routing. Full eventSender object is available under data.eventSender.",
      "type": "string",
      "enum": ["broker", "insurer", "serviceprovider"]
    },
    "eventSenderId": {
      "description": "Sender IDP identifier used for filtering and routing. Full eventSender object is available under data.eventSender.",
      "type": "string",
      "minLength": 3
    },
    "eventSenderOnBehalfBy": {
      "description": "Optional IDP number of the software provider's techUser if the event is sent on behalf.",
      "type": "string",
      "pattern": "^IDP(\\d{7})$"
    },
    "data": {
      "$ref": "IDSEventDataType.json"
    },
    "processGroupId": {
      "$ref": "../event-generic/ProcessGroupIdType.json"
    },
    "processId": {
      "$ref": "../event-generic/ProcessIdType.json"
    },
    "processName": {
      "$ref": "../event-generic/ProcessNameType.json"
    },
    "processVersion": {
      "$ref": "../event-generic/ProcessVersionType.json"
    },
    "processStatus": {
      "$ref": "../event-generic/ProcessStatusType.json"
    },
    "subProcessName": {
      "$ref": "../event-generic/SubProcessNameGenericProcessType.json"
    },
    "subProcessStatus": {
      "$ref": "../event-generic/SubProcessStatusType.json"
    },
    "idsconfidenceScore": {
      "description": "Scalar projection of data.idsbasicProcessingMetadata.idsconfidenceScore for routing and quality gating.",
      "$ref": "./specific-types/idsconfidenceScoreType.json"
    },
    "idsdocumentQuality": {
      "description": "Scalar projection of data.idsdocumentQualityMetrics.idsdocumentQuality for routing and quality tier signals.",
      "$ref": "./specific-types/idsdocumentQualityType.json"
    },
    "idsisValid": {
      "description": "Scalar projection of data.idsvalidationResults.isValid for routing and filtering.",
      "type": "boolean"
    },
    "idsroutingDecision": {
      "description": "Scalar projection of data.idsvalidationResults.routingDecision for routing and filtering.",
      "type": "string",
      "enum": ["auto-approve", "manual-review", "reject", "re-process"]
    },
    "idsrequiresHumanReview": {
      "description": "Scalar projection of data.idsvalidationResults.requiresHumanReview for routing and filtering.",
      "type": "boolean"
    },
    "idsreviewReason": {
      "description": "Scalar projection of data.idsvalidationResults.reviewReason for search and operational triage.",
      "type": "string"
    },
    "idstokenUsageTotal": {
      "description": "Scalar projection of data.idsbasicProcessingMetadata.idstokenUsage.total for search, reporting, and cost analysis.",
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "specversion",
    "type",
    "processId",
    "processName",
    "processVersion",
    "subProcessName",
    "processStatus",
    "subProcessStatus",
    "eventReceiverCategory",
    "eventReceiverId",
    "eventSenderCategory",
    "eventSenderId",
    "userAgentName",
    "userAgentVersion",
    "licenceKey"
  ],
