        "dataschema": "https://raw.githubusercontent.com/EcoHub-AG/Standards/refs/heads/main/schemas/legacy/5.4.1/contractGeneric_V5.4.1.xsd",
        "subject": "offer nlpi request",
        "time": "2023-08-17T14:15:22.000Z",
        "licenceKey": "REcxZEVMZWV1UXFwOUZwaz...",
        "userAgent": {
