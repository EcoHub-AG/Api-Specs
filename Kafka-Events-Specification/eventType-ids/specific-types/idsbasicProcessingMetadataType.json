{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Fundamental IDS processing metadata aligned with OAS IdsBasicProcessingMetadata.",
  "type": "object",
  "properties": {
    "idsprocessingModel": {
      "description": "AI/ML model used to process the document (e.g., 'Claude-3.5-Sonnet', 'GPT-4-Vision', 'Azure-Document-Intelligence')",
      "type": "string"
    },
    "idsmodelVersion": {
      "description": "Version identifier of the AI model",
      "type": "string"
    },
    "idsextractionMode": {
      "type": ["null", "string"]
    },
    "idsllmCallCount": {
      "type": ["null", "integer"],
      "minimum": 0
    },
    "idsmajorityVoting": {
      "type": ["null", "boolean"]
    },
    "idspromptRepetition": {
      "type": ["null", "boolean"]
    },
    "idsdpi": {
      "type": ["null", "integer"],
      "minimum": 0
    },
    "idsimageQuality": {
      "type": ["null", "integer"],
      "minimum": 0
    },
    "idspsm": {
      "type": ["null", "integer"],
      "minimum": 0
    },
    "idsocrEngineMode": {
      "type": ["null", "string"]
    },
    "idsprocessingTimeMs": {
      "description": "Elapsed time for document processing in milliseconds",
      "type": ["null", "number"],
      "minimum": 0
    },
    "idspostprocessingTimeMs": {
      "type": ["null", "number"],
      "minimum": 0
    },
    "idsllmResponseTimeMs": {
      "type": ["null", "number"],
      "minimum": 0
    },
    "idsconfidenceScore": {
      "type": ["null", "number"],
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
