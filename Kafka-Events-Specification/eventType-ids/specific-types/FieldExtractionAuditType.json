{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Field provenance audit entries aligned with OAS idsfieldExtractionAudit.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "fieldName": {
        "type": "string"
      },
      "xPath": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "ApiGenerated",
            "Generated",
            "DefaultValue",
            "LlmGenerated",
            "PostProcessed",
            "PostLlmCalculated"
          ]
        }
      },
      "description": {
        "type": "string"
      }
    },
    "required": [
      "fieldName",
      "xPath",
      "sources",
      "description"
    ],
    "additionalProperties": false
  }
}
