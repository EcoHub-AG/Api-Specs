{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Document-level quality assessment that guides receiver review strategy and time budgets.",
  "type": "object",
  "properties": {
    "overallQuality": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "idsdocumentQualityType.json"
        }
      ]
    },
    "qualityFactors": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "documentReadability": {
              "description": "Document text legibility score",
              "type": ["null", "number"],
              "minimum": 0,
              "maximum": 1
            },
            "structureRecognition": {
              "description": "Form/table structure recognition score",
              "type": ["null", "number"],
              "minimum": 0,
              "maximum": 1
            },
            "handwritingPresence": {
              "type": ["null", "boolean"]
            },
            "imageQuality": {
              "description": "Image quality score (for scanned documents)",
              "type": ["null", "number"],
              "minimum": 0,
              "maximum": 1
            },
            "ocrQuality": {
              "description": "OCR accuracy score",
              "type": ["null", "number"],
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "receiverRecommendedStrategy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "approachSuggested": {
              "type": ["null", "string"],
              "enum": ["full-review", "targeted-review", "spot-check", "accept", null]
            },
            "reasoning": {
              "description": "Explanation for the recommended strategy",
              "type": ["null", "string"]
            },
            "fieldsRequiringExtraAttention": {
              "description": "List of field paths requiring extra scrutiny",
              "type": ["null", "array"],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "estimatedManualReviewMinutes": {
      "description": "Estimated time in minutes for manual review",
      "type": ["null", "integer"],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
