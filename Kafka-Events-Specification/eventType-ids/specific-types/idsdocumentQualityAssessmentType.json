{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Document-level quality assessment that guides receiver review strategy and time budgets.",
  "type": "object",
  "properties": {
    "overallQuality": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "idsdocumentQualityType.json"
        }
      ]
    },
    "qualityFactors": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "documentReadability": {
              "type": ["null", "number", "string"],
              "minimum": 0,
              "maximum": 1,
              "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
            },
            "structureRecognition": {
              "type": ["null", "number", "string"],
              "minimum": 0,
              "maximum": 1,
              "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
            },
            "handwritingPresence": {
              "type": ["null", "boolean"]
            },
            "imageQuality": {
              "type": ["null", "number", "string"],
              "minimum": 0,
              "maximum": 1,
              "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
            },
            "ocrQuality": {
              "type": ["null", "number", "string"],
              "minimum": 0,
              "maximum": 1,
              "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "receiverRecommendedStrategy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "approachSuggested": {
              "type": ["null", "string"],
              "enum": ["full-review", "targeted-review", "spot-check", "accept", null]
            },
            "reasoning": {
              "type": ["null", "string"]
            },
            "fieldsRequiringExtraAttention": {
              "type": ["null", "array"],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "estimatedManualReviewMinutes": {
      "type": ["null", "integer", "string"],
      "minimum": 0,
      "pattern": "^(0|[1-9]\\d*)$"
    }
  },
  "additionalProperties": false
}
