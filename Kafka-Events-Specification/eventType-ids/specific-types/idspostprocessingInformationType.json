{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Postprocessing change information aligned with OAS PostProcessingInformation.",
  "type": "object",
  "properties": {
    "message": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "oldValue": {
      "type": ["null", "string"]
    },
    "newValue": {
      "type": ["null", "string"]
    }
  },
  "required": ["message", "field", "oldValue", "newValue"],
  "additionalProperties": false
}
