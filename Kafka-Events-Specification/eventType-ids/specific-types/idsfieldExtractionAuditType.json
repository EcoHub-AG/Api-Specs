{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Field provenance audit entries aligned with OAS idsfieldExtractionAudit.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "fieldName": {
        "type": "string"
      },
      "xPath": {
        "type": "string"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "ApiGenerated",
            "Generated",
            "DefaultValue",
            "LlmGenerated",
            "PostProcessed",
            "PostLlmCalculated"
          ]
        }
      },
      "description": {
        "type": ["null", "string"]
      }
    },
    "required": ["fieldName", "xPath", "sources", "description"],
    "additionalProperties": false
  }
}
