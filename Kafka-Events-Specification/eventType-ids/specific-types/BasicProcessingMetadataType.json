{
  "description": "Fundamental IDS processing metadata aligned with OAS IdsBasicProcessingMetadata.",
  "type": "object",
  "properties": {
    "processingModel": {
      "$ref": "./ProcessingModelType.json"
    },
    "modelVersion": {
      "$ref": "./ModelVersionType.json"
    },
    "extractionMode": {
      "type": "string",
      "description": "Mode of field extraction (e.g., 'zero-shot', 'few-shot', 'template-based')",
      "nullable": true
    },
    "llmCallCount": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
    },
    "majorityVoting": {
      "type": "boolean",
      "nullable": true
    },
    "promptRepetition": {
      "type": "boolean",
      "nullable": true
    },
    "dpi": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
    },
    "imageQuality": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
    },
    "psm": {
      "type": "integer",
      "minimum": 0,
      "nullable": true
    },
    "ocrEngineMode": {
      "type": "string",
      "nullable": true
    },
    "processingTimeMs": {
      "$ref": "./ProcessingTimeMsType.json"
    },
    "postprocessingTimeMs": {
      "$ref": "./ProcessingTimeMsType.json"
    },
    "llmResponseTimeMs": {
      "$ref": "./ProcessingTimeMsType.json"
    },
    "confidenceScore": {
      "$ref": "./ConfidenceScoreType.json"
    }
  },
  "additionalProperties": false
}
