{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Multi-level action recommendations for the receiver: field-level, document-level, and decision matrices.",
  "type": "object",
  "properties": {
    "summary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "fieldsCount": {
              "description": "Total number of fields extracted",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "fieldsAccept": {
              "description": "Number of high-confidence fields (ACCEPT)",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "fieldsReview": {
              "description": "Number of medium-confidence fields (REVIEW)",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "fieldsVerify": {
              "description": "Number of low-confidence fields (VERIFY)",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "documentLevelIssues": {
              "description": "Number of document-level issues detected",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "estimatedManualReviewMinutes": {
              "description": "Total estimated time for manual review",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "overallStrategy": {
              "type": "string",
              "enum": ["accept", "spot-check", "targeted-review", "full-review"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fieldRecommendations": {
      "type": ["null", "array"],
      "items": {
        "type": "object",
        "properties": {
          "fieldPath": {
            "description": "JSON path to the field",
            "type": ["null", "string"]
          },
          "recommendation": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "VERIFY", "REJECT"]
          },
          "priority": {
            "description": "Priority order (1 = highest, higher number = lower priority)",
            "type": ["null", "integer"],
            "minimum": 1
          },
          "reasons": {
            "description": "Reasons for this recommendation",
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "confidenceScore": {
            "description": "Current confidence score for this field",
            "type": ["null", "number"],
            "minimum": 0,
            "maximum": 1
          },
          "threshold": {
            "description": "Confidence threshold applicable to this field",
            "type": ["null", "number"],
            "minimum": 0,
            "maximum": 1
          },
          "whatToCheckFor": {
            "description": "Guidance on what to verify for this field",
            "type": ["null", "string"]
          },
          "alternativeValues": {
            "description": "Alternative values that could replace the current value",
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "estimatedTimeMinutes": {
            "description": "Estimated time in minutes to review this field",
            "type": ["null", "integer"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "documentLevelRecommendations": {
      "type": ["null", "array"],
      "items": {
        "type": "object",
        "properties": {
          "recommendation": {
            "description": "Type of recommendation (e.g., 'HANDWRITING_DETECTED', 'LOW_OCR_QUALITY')",
            "type": ["null", "string"]
          },
          "affectedPages": {
            "type": ["null", "array"],
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "affectedFields": {
            "description": "List of affected field paths",
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "whatToDo": {
            "type": ["null", "string"]
          },
          "estimatedTimeMinutes": {
            "description": "Estimated time in minutes to address this issue",
            "type": ["null", "integer"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "receiverDecisionMatrix": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "acceptWithoutReview": {
              "$ref": "#/definitions/receiverDecisionGroup"
            },
            "spotCheckRecommended": {
              "$ref": "#/definitions/receiverDecisionGroup"
            },
            "manualVerificationRequired": {
              "$ref": "#/definitions/receiverDecisionGroup"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "definitions": {
    "receiverDecisionGroup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "description": "Number of fields in this group",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "action": {
              "description": "Recommended action for this group",
              "type": ["null", "string"]
            },
            "estimatedMinutes": {
              "description": "Estimated time in minutes for this group",
              "type": ["null", "integer"],
              "minimum": 0
            },
            "fields": {
              "description": "List of field paths in this group",
              "type": ["null", "array"],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
