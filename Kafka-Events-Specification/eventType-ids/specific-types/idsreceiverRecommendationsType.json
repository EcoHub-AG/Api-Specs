{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Multi-level action recommendations for the receiver: field-level, document-level, and decision matrices",
  "type": "object",
  "properties": {
    "summary": {
      "description": "Quick summary of recommendations across all fields",
      "type": "object",
      "properties": {
        "fieldsCount": {
          "description": "Total number of fields extracted",
          "type": "integer",
          "minimum": 0
        },
        "fieldsAccept": {
          "description": "Number of fields recommended to ACCEPT without review",
          "type": "integer",
          "minimum": 0
        },
        "fieldsReview": {
          "description": "Number of fields recommended for REVIEW (spot-check)",
          "type": "integer",
          "minimum": 0
        },
        "fieldsVerify": {
          "description": "Number of fields recommended to VERIFY (manual validation)",
          "type": "integer",
          "minimum": 0
        },
        "documentLevelIssues": {
          "description": "Count of document-level issues identified",
          "type": "integer",
          "minimum": 0
        },
        "estimatedManualReviewMinutes": {
          "description": "Total estimated time for manual review of recommended fields",
          "type": "integer",
          "minimum": 0
        },
        "overallStrategy": {
          "description": "Suggested overall review strategy based on field-level recommendations",
          "type": "string",
          "enum": ["full-review", "targeted-review", "spot-check", "accept"]
        }
      },
      "required": ["fieldsCount", "fieldsAccept", "fieldsReview", "fieldsVerify"],
      "additionalProperties": false
    },
    "fieldRecommendations": {
      "description": "Per-field action recommendations with reasons and guidance",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldPath": {
            "description": "Identifier of the field",
            "type": "string"
          },
          "recommendation": {
            "description": "Recommended action for receiver",
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "VERIFY", "REJECT"]
          },
          "priority": {
            "description": "Priority ranking (1=highest, 4=lowest) for executing recommendations",
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "reasons": {
            "description": "List of reasons why this recommendation was made",
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["confidence_below_threshold", "confidence_near_threshold", "handwritten_text", "ocr_quality_low", "validation_failed", "validation_warning", "high_risk_field", "readability_issue", "format_mismatch", "business_rule_violation"]
            }
          },
          "confidenceScore": {
            "description": "Extraction confidence for this field (0-1)",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "threshold": {
            "description": "The confidence threshold used to make this recommendation",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "whatToCheckFor": {
            "description": "Specific actionable guidance for manual verification",
            "type": "string"
          },
          "alternativeValues": {
            "description": "Other values considered by the model for this field",
            "type": "array",
            "items": {}
          },
          "estimatedTimeMinutes": {
            "description": "Estimated time for manual review of this field",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["fieldPath", "recommendation"],
        "additionalProperties": false
      }
    },
    "documentLevelRecommendations": {
      "description": "Cross-cutting issues affecting multiple fields or the entire document",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "recommendation": {
            "description": "Type of document-level issue",
            "type": "string",
            "enum": ["HIGH_OCR_RISK", "HANDWRITING_DETECTED", "LOW_DOCUMENT_QUALITY", "STRUCTURE_UNRECOGNIZED", "MISSING_PAGES", "CUSTOM_ISSUE"]
          },
          "affectedPages": {
            "description": "Page numbers affected by this issue (1-indexed)",
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "affectedFields": {
            "description": "Field paths affected by this issue",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "whatToDo": {
            "description": "Actionable guidance for addressing this issue",
            "type": "string"
          },
          "estimatedTimeMinutes": {
            "description": "Estimated time to address this issue",
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["recommendation", "whatToDo"],
        "additionalProperties": false
      }
    },
    "receiverDecisionMatrix": {
      "description": "Grouped summary for quick action planning by the receiver",
      "type": "object",
      "properties": {
        "acceptWithoutReview": {
          "description": "Fields with high confidence that require no manual verification",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["count"],
          "additionalProperties": false
        },
        "spotCheckRecommended": {
          "description": "Fields requiring quick verification or spot-checking",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string"
            },
            "estimatedMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["count"],
          "additionalProperties": false
        },
        "manualVerificationRequired": {
          "description": "Fields requiring full manual verification",
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "action": {
              "type": "string"
            },
            "estimatedMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["count"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
