{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Multi-level action recommendations for the receiver: field-level, document-level, and decision matrices.",
  "type": "object",
  "properties": {
    "summary": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "fieldsCount": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "fieldsAccept": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "fieldsReview": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "fieldsVerify": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "documentLevelIssues": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "estimatedManualReviewMinutes": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "overallStrategy": {
              "type": "string",
              "enum": ["accept", "spot-check", "targeted-review", "full-review"]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "fieldRecommendations": {
      "type": ["null", "array"],
      "items": {
        "type": "object",
        "properties": {
          "fieldPath": {
            "type": ["null", "string"]
          },
          "recommendation": {
            "type": "string",
            "enum": ["ACCEPT", "REVIEW", "VERIFY", "REJECT"]
          },
          "priority": {
            "type": ["null", "integer", "string"],
            "minimum": 1,
            "pattern": "^(0|[1-9]\\d*)$"
          },
          "reasons": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "confidenceScore": {
            "type": ["null", "number", "string"],
            "minimum": 0,
            "maximum": 1,
            "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
          },
          "threshold": {
            "type": ["null", "number", "string"],
            "minimum": 0,
            "maximum": 1,
            "pattern": "^(0(\\.\\d+)?|1(\\.0+)?)$"
          },
          "whatToCheckFor": {
            "type": ["null", "string"]
          },
          "alternativeValues": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "estimatedTimeMinutes": {
            "type": ["null", "integer", "string"],
            "minimum": 0,
            "pattern": "^(0|[1-9]\\d*)$"
          }
        },
        "additionalProperties": false
      }
    },
    "documentLevelRecommendations": {
      "type": ["null", "array"],
      "items": {
        "type": "object",
        "properties": {
          "recommendation": {
            "type": ["null", "string"]
          },
          "affectedPages": {
            "type": ["null", "array"],
            "items": {
              "type": ["integer", "string"],
              "minimum": 1,
              "pattern": "^(0|[1-9]\\d*)$"
            }
          },
          "affectedFields": {
            "type": ["null", "array"],
            "items": {
              "type": "string"
            }
          },
          "whatToDo": {
            "type": ["null", "string"]
          },
          "estimatedTimeMinutes": {
            "type": ["null", "integer", "string"],
            "minimum": 0,
            "pattern": "^(0|[1-9]\\d*)$"
          }
        },
        "additionalProperties": false
      }
    },
    "receiverDecisionMatrix": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "acceptWithoutReview": {
              "$ref": "#/definitions/receiverDecisionGroup"
            },
            "spotCheckRecommended": {
              "$ref": "#/definitions/receiverDecisionGroup"
            },
            "manualVerificationRequired": {
              "$ref": "#/definitions/receiverDecisionGroup"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "definitions": {
    "receiverDecisionGroup": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "count": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "action": {
              "type": ["null", "string"]
            },
            "estimatedMinutes": {
              "type": ["null", "integer", "string"],
              "minimum": 0,
              "pattern": "^(0|[1-9]\\d*)$"
            },
            "fields": {
              "type": ["null", "array"],
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
