{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Offer NLPI error event, i.e. an event for errors which related to the event payload.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../CloudEventsType.json#/$defs/iddef"
    },
    "source": {
      "$ref": "../CloudEventsType.json#/$defs/sourcedef"
    },
    "specversion": {
      "$ref": "../CloudEventsType.json#/$defs/specversiondef"
    },
    "type": {
      "description": "Reverse DNS entry defining the Standard error SAF event type. Restricted to ch.ecohub.saf.standard-error for Standard process error events (member of EventType).",
      "type": "string",
      "enum": ["ch.ecohub.saf.standard-error"]
    },
    "datacontenttype": {
      "$ref": "../CloudEventsType.json#/$defs/datacontenttypedef"
    },
    "dataschema": {
      "$ref": "../CloudEventsType.json#/$defs/dataschemadef"
    },
    "subject": {
      "$ref": "../CloudEventsType.json#/$defs/subjectdef"
    },
    "time": {
      "$ref": "../CloudEventsType.json#/$defs/timedef"
    },
    "licenceKey": {
      "$ref": "../event-common-types/LicenceKeyType.json"
    },
    "userAgent": {
      "$ref": "../event-common-types/UserAgentType.json"
    },
    "data": {
      "$ref": "#/$defs/offerNLPIErrorType"
    },
    "eventReceiver": {
      "$ref": "../event-common-types/SenderReceiverType.json"
    },
    "eventSender": {
      "$ref": "../event-common-types/SenderReceiverType.json"
    },
    "processGroupId": {
      "$ref": "../event-common-types/ProcessGroupIdType.json"
    },
    "processId": {
      "$ref": "../event-common-types/ProcessIdType.json"
    },
    "processName": {
      "$ref": "../event-common-types/ProcessNameType.json"
    },
    "processVersion": {
      "$ref": "../event-common-types/ProcessVersionType.json"
    },
    "processStatus": {
      "$ref": "../event-common-types/ProcessStatusType.json"
    },
    "subProcessName": {
      "$ref": "../event-common-types/SubProcessNameType.json"
    },
    "subProcessStatus": {
      "$ref": "../event-common-types/SubProcessStatusType.json"
    }
  },
  "$defs": {
    "offerNLPIErrorType": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "errorCode": {
            "description": "The code best describing the occured error.",
            "minLength": 3,
            "type": "string",
            "enum": [
              "other"
            ]
          },
          "errorMessage": {
            "description": "Error message",
            "minLength": 3,
            "type": "string"
          },
          "path": {
            "description": "xPath or JsonPath to the property where the error occurred.",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "errorCode",
          "errorMessage"
        ]
      }
    }
  },
  "required": [
    "id",
    "source",
    "specversion",
    "type",
    "data",
    "processId",
    "processName",
    "processVersion",
    "subProcessName",
    "processStatus",
    "subProcessStatus",
    "eventReceiver",
    "eventSender",
    "userAgent",
    "licenceKey"
  ],
  "additionalProperties": false
}