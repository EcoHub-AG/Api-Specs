{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "description": "Provisioning SAF event used to manage user, member and organisation provisioning steps.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../CloudEventsType.json#/$defs/iddef"
    },
    "source": {
      "$ref": "../CloudEventsType.json#/$defs/sourcedef"
    },
    "specversion": {
      "$ref": "../CloudEventsType.json#/$defs/specversiondef"
    },
    "type": {
      "description": "Reverse DNS entry defining the provisioning SAF event type. Restricted to ch.ecohub.saf.provisioning for provisioning events (member of EventType).",
      "type": "string",
      "enum": ["ch.ecohub.saf.provisioning"]
    },
    "datacontenttype": {
      "$ref": "../CloudEventsType.json#/$defs/datacontenttypedef"
    },
    "dataschema": {
      "$ref": "../CloudEventsType.json#/$defs/dataschemadef"
    },
    "subject": {
      "$ref": "../CloudEventsType.json#/$defs/subjectdef"
    },
    "time": {
      "$ref": "../CloudEventsType.json#/$defs/timedef"
    },
    "licenceKey": {
      "$ref": "../event-common-types/LicenceKeyType.json"
    },
    "userAgent": {
      "$ref": "../event-common-types/UserAgentType.json"
    },
    "eventReceiver": {
      "$ref": "../event-common-types/SenderReceiverType.json"
    },
    "eventSender": {
      "$ref": "../event-common-types/SenderReceiverType.json"
    },
    "data": {
      "$ref": "../event-common-types/EventDataType.json"
    },
    "processGroupId": {
      "$ref": "../event-common-types/ProcessGroupIdType.json"
    },
    "processId": {
      "$ref": "../event-common-types/ProcessIdType.json"
    },
    "processName": {
      "description": "Identifier of the provisioning process.",
      "type": "string",
      "allOf": [
        {
          "$ref": "../event-common-types/GenericProcessNameType.json"
        },
        {
          "enum": ["provisioning"]
        }
      ]
    },
    "processVersion": {
      "$ref": "../event-common-types/ProcessVersionType.json"
    },
    "processStatus": {
      "$ref": "../event-common-types/ProcessStatusType.json"
    },
    "subProcessName": {
      "description": "Identifier of the provisioning subprocess step.",
      "type": "string",
      "allOf": [
        {
          "$ref": "../event-common-types/GenericSubProcessNameType.json"
        },
        {
          "enum": ["userProvisioning", "memberProvisioning", "orgProvisioning"]
        }
      ]
    },
    "subProcessStatus": {
      "$ref": "../event-common-types/SubProcessStatusType.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "specversion",
    "type",
    "processId",
    "processName",
    "processVersion",
    "subProcessName",
    "processStatus",
    "subProcessStatus",
    "eventReceiver",
    "eventSender",
    "userAgent",
    "licenceKey"
  ],
  "examples": [
    {
      "name": "provisioningEventWithPayloadExample",
      "summary": "Provisioning SAF event",
      "payload": {
        "id": "044d2e50-12d6-43e4-bb1b-7b54841c9c82",
